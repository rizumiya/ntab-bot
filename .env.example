# Salin berkas ini menjadi .env lalu isi nilainya.

# --- WAJIB ---------------------------------------------------------------
# Token dari @BotFather
BOT_TOKEN=
# ID Telegram pemilik bot (angka; lihat di @userinfobot). Pemilik mendapat panel admin dan backup harian.
OWNER_ID=

# --- OPSIONAL ------------------------------------------------------------
# Mesin pencari saat pengguna mengetik "@bot kata kunci" tanpa awalan
DEFAULT_INLINE_PREFIX=.wh

# Image proxy: hanya perlu untuk thumbnail Gelbooru di mode inline.
# Butuh alamat HTTPS publik (subdomain di nginx, contoh: deploy/nginx-ntab.conf) yang meneruskan ke PROXY_HOST:PROXY_PORT.
ENABLE_IMAGE_PROXY=false
PROXY_HOST=127.0.0.1
PROXY_PORT=3080
PROXY_PUBLIC_URL=

# DNS alternatif. Nyalakan hanya bila jaringan Anda memblokir situs sumber (umum di ISP Indonesia).
# Di VPS biarkan false.
ENABLE_CUSTOM_DNS=false

# Cookie PHPSESSID akun Pixiv (cara mengambil: lihat README). Membuka karya berlabel dewasa di pencarian.
PIXIV_PHPSESSID=

# Kunci SauceNAO (saucenao.com > Account > api). Tanpa ini, /sauce hanya mengenali tangkapan layar anime.
SAUCENAO_API_KEY=

# Alamat situs Kiryuu. Ubah di sini bila domainnya berganti.
KIRYUU_URL=https://v7.kiryuu.to

# API Gelbooru (gelbooru.com > Account > Options). Membuat pencarian lebih cepat dan menampilkan GIF/video.
# Tanpa ini, Gelbooru dibaca lewat halaman HTML.
GELBOORU_USER_ID=
GELBOORU_API_KEY=

# Batas beban. Nilai bawaan cocok untuk VPS kecil yang dipakai bersama layanan lain.
MAX_UPDATE_CONCURRENCY=8
MAX_ALBUM_JOBS=2
MAX_FFMPEG_JOBS=1

# "debug" mencatat setiap update ke log (jangan dipakai di produksi)
LOG_LEVEL=info
