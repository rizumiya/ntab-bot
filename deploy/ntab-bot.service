[Unit]
Description=NTAB Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ntab
Group=ntab
WorkingDirectory=/opt/ntab-bot
# --max-old-space-size: Node membersihkan memori lebih rajin, tidak menunggu sampai mendekati batas systemd
# --dns-result-order=ipv4first: jalur IPv6 server ini ke Telegram pernah menggantung tanpa error,
# membuat bot tersangkut saat menyala. IPv4 selalu dicoba lebih dulu.
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning --max-old-space-size=192 --dns-result-order=ipv4first dist/main.js
Restart=always
RestartSec=5
TimeoutStopSec=15

# Batas sumber daya: bot tidak boleh mengganggu layanan lain di server yang sama
MemoryHigh=384M
MemoryMax=512M
CPUQuota=80%
Nice=10
TasksMax=64

# Isolasi
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ntab-bot/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
